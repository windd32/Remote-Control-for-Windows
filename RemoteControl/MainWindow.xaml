<Window x:Class="RemoteControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Remote Control" Height="760" Width="1100" MinHeight="600" MinWidth="850">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RoleBox" Width="180" SelectedIndex="1" SelectionChanged="RoleBox_SelectionChanged"><ComboBoxItem Content="Controller"/><ComboBoxItem Content="Client (this PC)"/></ComboBox><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Margin="20,0,0,0"/></StackPanel>
  <Grid Grid.Row="1">
   <Grid x:Name="ControllerPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Port:" VerticalAlignment="Center"/><TextBox x:Name="PortBox" Text="45831" Width="90" Margin="8,0,10,0"/><Button x:Name="ListenButton" Content="Start listening" Click="Listen_Click" Padding="12,5"/><TextBlock Text="Client enters your public IP and port." VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel><Border Grid.Row="1" Background="#15191F"><Image x:Name="RemoteImage" Stretch="Uniform" Focusable="True" MouseMove="RemoteImage_MouseMove" MouseDown="RemoteImage_MouseDown" MouseUp="RemoteImage_MouseUp" KeyDown="RemoteImage_KeyDown" KeyUp="RemoteImage_KeyUp"/></Border></Grid>
   <Grid x:Name="ClientPanel"><StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Connect to controller" FontSize="22" Margin="0,0,0,16"/><TextBlock Text="Controller IP address"/><TextBox x:Name="HostBox" Margin="0,4,0,12" Padding="7"/><TextBlock Text="Port"/><TextBox x:Name="ClientPortBox" Text="45831" Margin="0,4,0,12" Padding="7"/><Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Padding="12,7"/><TextBlock Text="Screen sharing and control require approval on this PC. Close the window to disconnect." TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Grid>
  </Grid><TextBlock Grid.Row="2" Text="Prototype for trusted connections. Do not use on untrusted networks." Margin="0,12,0,0" Foreground="#666"/>
 </Grid>
</Window>
